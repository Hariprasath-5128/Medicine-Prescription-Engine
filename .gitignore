__pycache__/
*.py[cod]
.venv/
venv/
# Raw downloads stay out: both are one command away via the Kaggle API
# (scripts/02_prepare_data.py), and drugsComTrain_raw.csv alone is 83 MB.
data/raw/*
!data/raw/.gitkeep

# Processed data IS committed, via Git LFS (see .gitattributes). These are the
# deduplicated, leakage-checked splits the models actually train on, so they
# pin the exact data behind any reported metric.
!data/processed/
!data/processed/*.csv
!data/processed/*.jsonl
!data/processed/*.json

# Trained weights: regenerated by scripts 03 and 04
artifacts/
*.bin
*.safetensors
.env
kaggle.json
.pytest_cache/

# Evidence index: rebuilt by scripts/00_setup_evidence_db.py from SERA
# in under a minute, so it is not worth 632 MB of LFS quota.
data/chroma/
